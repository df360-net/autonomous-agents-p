# THE VARIABLES AN AGENT READS, and why each one is set the way it is.
#
# This is a REFERENCE, not a file the fleet loads. Agents run as Kubernetes pods: the secrets
# arrive in a Secret (see provision_agent.py) and the rest in the pod spec, both owned by the
# infra/ops side. It is kept here because the reasoning belongs next to the code that reads
# these values, and because it is the checklist for what a new agent needs.
#
# Everything except the secrets has a working default in the code, so an agent with only its
# credentials set will start. Env is read at process start: a change needs a pod restart, and
# a change to a Secret needs the pod recreated.
#
# It is still a usable `.env` for running the worker or the brain on a workstation. `.env` is
# gitignored — never commit real values.


# ─── Secrets ──────────────────────────────────────────────────────────────────────────────

# Your DeepSeek key. Never echo it back to a terminal.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Who this agent IS. Everything else — mailbox, memory path, labels, ledger key — is derived
# from these two by fleet_identity.py, which is the point: an address that can be set
# independently of a name is an address that can be paired with the wrong workspace.
TENANT=dev
AGENT_NAME=

# This agent's mailbox password. Do NOT hand-write it and do NOT store it here on a real
# deployment: `provision_agent.py <name>` creates the mailbox, prints the password once into a
# k8s Secret, and forgets it. Re-running rotates both halves in the same run, which is why
# re-running is safe and discarding the output is not.
AGENT_PASSWORD=
# Only for scripts/task_agent.py, which sends AS the boss from a workstation.
BOSS_PASSWORD=
# validatorN@ is a SEND-AS ALIAS for agentN@, not an account: authenticate as the agent and
# put the validator address in the From header. There is no validator mailbox and no validator
# password, so an attempt to log in as one fails outright. See mail/README.md.

# Signs agent-to-agent messages so agent_principal can tell a real peer from anything else on
# the LAN that can write an X-Agent-Id header. THE SAME VALUE ON EVERY AGENT IN THE FLEET.
# Empty means no agent-to-agent traffic is accepted at all — the right posture until there is
# a second agent, and wrong the moment there is. Generated ONCE for the whole fleet and held
# in the shared Secret — provision_agent.py deliberately does not mint it, because a
# per-agent value would silently partition the fleet into agents that cannot talk.
FLEET_HMAC_SECRET=

# ---- The fleet control plane -----------------------------------------------------
# The kill switch, the fleet spend total, the inter-agent thread cap, app registration and
# review verdicts. Live at http://hp-tiger:8091.
#
# Leave EMPTY only when running the agent off the fleet. Empty means "not in use": the kill
# switch is FLEET_PAUSE_FILE and the fleet total is FLEET_LEDGER, exactly as before.
#
# Set it and both move to the control plane, because a shared bind mount stops being shared
# once agents are PODs on two boxes — at which point a "$500 fleet ceiling" is really $500 per
# agent and a kill switch that claims to stop everybody stops one container.
#
# ONCE SET, UNREACHABLE MEANS PAUSED. An agent that cannot confirm it is allowed to spend money
# does not spend money. That is the opposite of how the file behaves and it is deliberate: an
# unreadable local file means this container is broken, while an unreachable control plane
# means nothing can stop the fleet. Do not point this at a URL that is not up yet.
#   FLEET_CONTROL_URL=http://hp-tiger:8091
FLEET_CONTROL_URL=
FLEET_TOKEN=
# How long a successful "not paused" answer is trusted, and therefore HOW LONG A STOP TAKES.
# This bounds both cases, not just outages: the cache is checked before the request, so an
# agent holding a fresh answer will not ask again until it expires — however urgently someone
# is clicking pause in the dashboard. Worst case for an explicit pause AND for a control-plane
# outage is this many seconds. Lower it if that is too long to wait for a stop; the only cost
# is more requests to a single indexed settings read.
FLEET_PAUSE_TTL=60

# Who may task an agent. "*" is anyone who can reach the mail server, which is the default and
# is honest about a box running unauthenticated SMTP relay. The spend ceiling is the real
# bound. Narrow it to "@agents.local,you@example.com" when this is reachable more widely.
ALLOWED_SENDERS=*

# ---- How much agents may talk to each other --------------------------------------
# All three are read at container start, so change them here and re-run the deploy task.
#
# AGENT_MAX_HOPS is the length of a CHAIN of agent-to-agent messages: agent1 -> agent2 ->
# agent1 -> ... Each leg is a separate task at the far end, so this is the number of agent
# runs one conversation can cause. It is NOT the main cost control — the spend ceilings above
# are, and they keep working whatever this is set to. Set it to what a long exchange between
# agents legitimately needs; a 5-round competition where each side poses a question needs 11.
#
# ONE HOP IS ONE MESSAGE, so a round trip costs two: 20 is ten rounds. The counter resets for
# every new conversation a human starts, which is what makes this a per-topic budget rather
# than a daily one. It was 100 until two agents finished a competition, agreed it was over,
# and then spent thirty more messages agreeing about it — a ceiling nobody expects to reach
# is not a throttle, it is a footnote. Ten rounds is more than any exchange so far has
# legitimately needed, and hitting it is now visible: the agent is told when it is close.
AGENT_MAX_HOPS=20
# How many peers ONE task may write to. Bounds width, where hops bound depth: a single
# confused run fanning out to its peers is not something a hop count can see.
AGENT_MAX_PEER_SENDS=25
# Mail-loop guard for traffic that carries NO hop count — a forwarding rule, a mailing list,
# an out-of-office responder. Deliberately NOT applied to attested agent messages, which carry
# a real hop count already; raising AGENT_MAX_HOPS does not require touching this.
AGENT_MAX_THREAD_DEPTH=20

# GitHub PAT (classic) with `repo` AND `workflow` scope. ship_app uses it to create each
# agent-<app> repository and push to it. `workflow` is not optional: without it GitHub
# rejects any push touching .github/workflows/, with an error that reads like a permissions
# bug. Leave EMPTY to disable delivery — the agent is then told so explicitly and instructed
# to say it could not ship rather than claim it did.
GITHUB_TOKEN=


# ─── Tuning ───────────────────────────────────────────────────────────────────────────────
POLL_SECONDS=20
MAX_STEPS=200
# Review rounds before the reply is sent regardless, flagged. 0 disables the gate.
VALIDATION_ROUNDS=3
# Per tool result before truncation; every step resends the whole history.
MAX_TOOL_CHARS=8000
# Seconds before a shell command is killed.
BASH_TIMEOUT=300
MAX_REPLY_CHARS=40000
# Per notes file when pasted into a task (AGENT.md, AGENT-ASSETS.md, AGENT-AVOID.md).
NOTES_MAX_CHARS=8000


# ─── Memory: the part that outlives the container ─────────────────────────────────────────
# Two git clones under MEMORY_ROOT. `tenant/` is writable by any agent in the tenant;
# `fleet/` is read-only here and writable only by an operator, which is the mechanism that
# stops one tenant's secret becoming fleet-wide knowledge.
#
# TENANT UNSET means memory is local to the workspace — disabled, not broken. Tenant SET and
# unreachable WITH NO LOCAL CLONE means the agent refuses to start: an agent with amnesia does
# not do less work, it does the WRONG work — it redeploys apps it already runs.
#
# A FAILED PULL WITH A CLONE PRESENT IS SILENT BY DESIGN. The agent logs a WARNING and works
# from the stale clone, because a task a human is waiting on should not die because a remote
# blinked. So a central FLEET.md correction is best-effort per task: confirm the
# "memory: /memory/fleet <- ... ok" line rather than treating the push as delivery.
#   MEMORY_FLEET_REMOTE=https://github.com/df360-net/fleet-knowledge.git
MEMORY_TENANT_REMOTE=
MEMORY_FLEET_REMOTE=
MEMORY_ROOT=/memory


# ─── Local preview ports ──────────────────────────────────────────────────────────────────
# Where the agent runs an app WHILE BUILDING IT, inside its own container. NOTHING PUBLISHES
# THESE. A preview is reachable from the agent and its reviewer and from nowhere else, it dies
# with the pod, and it is not a deployment — see docs/Autonomous-Agents-Design.md §7.
#
# The agent is told, in those words, never to offer one of these as an address for a human to
# open. The fleet emails the real address itself once a pod is actually serving.
APP_PORT_BASE=3000
APP_PORT_COUNT=10

# APP_HOST IS GONE, AND ITS ABSENCE IS THE POINT. It was half of
# `http://{APP_HOST}:{PROXY_PORT_BASE + slot}` — an expression that produced a confident URL
# whether or not anything was listening on it, and did exactly that in real emails. The
# control plane allocates the address and reports it back, so there is nothing left to
# compute. Do not reintroduce either variable.


# ─── Delivery to Kubernetes (§9) ──────────────────────────────────────────────────────────
# Repos become <owner>/agent-<app>; images ghcr.io/<owner>/agent-<app>.
GITHUB_OWNER=df360-net

# How many apps one agent may claim in the cluster, and the NodePort its committed manifest
# SUGGESTS. Neither allocates anything: the control plane assigns the real box, port and URL
# when ship_app registers the app, which is why a collision is now impossible rather than
# unlikely. The number in the manifest is a plausible description of the app.
#
# Nothing retires an app yet, so this is a budget for TOTAL apps, not concurrent ones.
APP_SLOT_COUNT=20
NODE_PORT_BASE=30000

# Namespace agent apps are deployed into, kept separate so a bad agent deploy cannot disturb
# anything else on the cluster.
K8S_NAMESPACE=agent-apps
