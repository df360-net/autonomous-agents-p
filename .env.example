# Copy to .env on Zeenie and fill in. .env is gitignored — never commit real values.
#
# Every value below has a working default in docker-compose.yml, so an empty .env still
# starts — except the secrets, which have none.
#
# After changing anything here:  docker compose up -d
# Env is read when the container is CREATED, so `docker restart` will not pick up a change.


# ─── Secrets ──────────────────────────────────────────────────────────────────────────────

# Your DeepSeek key. Paste it directly on Zeenie; do not echo it back to a terminal.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mailbox passwords. These must match what you gave `setup email add` (see README step 3).
AGENT1_PASSWORD=
BOSS_PASSWORD=
# validator1 only sends, so the worker never uses this — but create the mailbox anyway.
VALIDATOR1_PASSWORD=

# GitHub PAT (classic) with `repo` AND `workflow` scope. ship_app uses it to create each
# agent-<app> repository and push to it. `workflow` is not optional: without it GitHub
# rejects any push touching .github/workflows/, with an error that reads like a permissions
# bug. Leave EMPTY to disable delivery — the agent is then told so explicitly and instructed
# to say it could not ship rather than claim it did.
GITHUB_TOKEN=


# ─── Tuning ───────────────────────────────────────────────────────────────────────────────
POLL_SECONDS=20
MAX_STEPS=200
# Review rounds before the reply is sent regardless, flagged. 0 disables the gate.
VALIDATION_ROUNDS=3
# Per tool result before truncation; every step resends the whole history.
MAX_TOOL_CHARS=8000
# Seconds before a shell command is killed.
BASH_TIMEOUT=300
MAX_REPLY_CHARS=40000
# Per notes file when pasted into a task (AGENT.md, AGENT-ASSETS.md, AGENT-AVOID.md).
NOTES_MAX_CHARS=8000


# ─── Local preview ports ──────────────────────────────────────────────────────────────────
# Where the agent runs an app WHILE BUILDING IT. A preview dies with the container and is not
# a deployment — see docs/Autonomous-Agents-Design.md §7.
#
# THESE THREE MUST AGREE. APP_PORT_RANGE is what Compose publishes; BASE and COUNT are what
# the worker hands out. Compose cannot compute one from the other, so the worker compares them
# at startup and warns loudly if they disagree — a port outside the published range is simply
# unreachable, which looks like a broken app rather than a configuration mistake.
APP_PORT_BASE=3000
APP_PORT_COUNT=10
APP_PORT_RANGE=3000-3009

# The address YOUR browser can reach. The container's own hostname is useless to you, so this
# is the LAN IP of the machine running the stack.
APP_HOST=192.168.0.21


# ─── Delivery to Kubernetes (§9) ──────────────────────────────────────────────────────────
# Repos become <owner>/agent-<app>; images ghcr.io/<owner>/agent-<app>.
GITHUB_OWNER=df360-net

# How many apps can live in the cluster AT ONCE — deliberately NOT the same number as
# APP_PORT_COUNT. A preview costs a published port on the agent's container; a cluster slot
# costs only a NodePort (the range runs to 32767) and one listener in agent-app-proxy.
#
# App slot N gets NodePort NODE_PORT_BASE+N and browser port PROXY_PORT_BASE+N.
#
# RAISING THIS TAKES TWO STEPS — change it here AND republish agent-app-proxy over the wider
# range, or the extra slots deploy fine and are reachable from nowhere:
#   docker rm -f agent-app-proxy
#   docker create --name agent-app-proxy --network kind --restart unless-stopped \
#     -p 31000-31019:31000-31019 -p 8091:8091 -e APP_SLOT_COUNT=20 \
#     python:3.12-slim python -u /agent_app_proxy.py
#   docker cp agent_app_proxy.py agent-app-proxy:/agent_app_proxy.py
#   docker start agent-app-proxy
#
# Above this the ceiling is the cluster itself: ~40 apps at 2 replicas before kind's 110-pod
# cap. And nothing retires an app yet, so this is a budget for TOTAL apps, not concurrent ones.
APP_SLOT_COUNT=20
NODE_PORT_BASE=30000
PROXY_PORT_BASE=31000

# Namespace Harness deploys agent apps into. Separate from harness-demo so a bad agent deploy
# cannot disturb the calculator or the governance app.
K8S_NAMESPACE=agent-apps
